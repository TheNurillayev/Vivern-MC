# Vivern MC - Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env into Git.

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_PUBLIC_URL=http://localhost:8000

# Telegram Bot & Mini App
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_IDS=8449563084

# Database
# Use sqlite+aiosqlite for local development, or postgresql+asyncpg for production
DATABASE_URL=sqlite+aiosqlite:///storage/vivern.db

# Storage Directory
STORAGE_DIR=storage

# Speech Recognition & Analysis (Adapters)
# Speech provider: 'mock' (for tests/offline), 'google_chirp'
SPEECH_PROVIDER=mock
GOOGLE_APPLICATION_CREDENTIALS=

# Analysis provider: 'heuristic' (for tests/offline), 'openai'
ANALYSIS_PROVIDER=heuristic
OPENAI_API_KEY=

# Business & Pricing Rules
PRICE_PER_ORDER_SOM=5000
FREE_TRIAL_GENERATIONS=3
JWT_SECRET=replace_with_a_secure_random_secret_key_at_least_32_chars
